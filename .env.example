# Copy this file to .env and fill in real values. Never commit .env.

# MetaTrader 5 — Exness account
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial   # Exness-MT5Trial | Exness-MT5Real | Exness-MT5Real2

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (Phase 2+ — leave blank if using SQLite to start)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=
DB_PASSWORD=

# Risk overrides (optional — defaults live in config/config.yaml)
RISK_PCT=0.01
DAILY_LOSS_KILL_PCT=0.04
MAX_CONCURRENT_RISK_PCT=0.06
